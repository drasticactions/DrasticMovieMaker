// Pixelate out of A and into B with a cross-fade at the middle. maxBlock 1 is a plain cross-fade.
uniform shader a;
uniform shader b;
uniform float2 resolution;
uniform float progress;
uniform float maxBlock;

half4 main(float2 p) {
    float scale = min(resolution.x, resolution.y) / 480.0;
    float peak = 1.0 - abs(progress * 2.0 - 1.0);
    float block = max(1.0, floor(mix(1.0, maxBlock, peak) * scale));
    float2 c = block > 1.0 ? (floor(p / block) + 0.5) * block : p;
    float mixAmount = maxBlock <= 1.0 ? progress : smoothstep(0.35, 0.65, progress);
    return mix(a.eval(c), b.eval(c), half(mixAmount));
}
