<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="https://github.com/avawpf"
             x:Class="AvaMovieMaker.App"
             Name="AvaMovieMaker"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <wpf:AvaWpfTheme Theme="Aero" />
    <wpf:AvaWpfControlsTheme />
    <StyleInclude Source="avares://AvaMovieMaker/Styles/MovieMaker.axaml" />
  </Application.Styles>
</Application>
