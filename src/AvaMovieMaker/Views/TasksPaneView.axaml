<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:str="using:AvaMovieMaker.ViewModels"
             xmlns:vm="using:AvaMovieMaker.ViewModels.Shell"
             xmlns:app="using:AvaMovieMaker"
             x:Class="AvaMovieMaker.Views.TasksPaneView"
             x:DataType="vm:TaskPaneViewModel"
             Width="{x:Static app:ShellMetrics.TasksWidth}"
             Background="{DynamicResource MmPaneBrush}"
             AutomationProperties.Name="{x:Static str:Strings.TasksPaneTasks}">
  <DockPanel Margin="0,0,4,0">
    <TextBlock DockPanel.Dock="Top" Text="{x:Static str:Strings.TasksPaneTasks}" Height="{x:Static app:ShellMetrics.TasksHeaderHeight}" Padding="6,8,0,0"
               Foreground="{DynamicResource MmTasksHeaderTextBrush}" />
    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,4,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskSection">
          <StackPanel Margin="0,0,0,7">
            <Grid ColumnDefinitions="Auto,*" Margin="14,0,0,0" Height="20">
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource MmTaskSectionTextBrush}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Margin="4,1,0,0" Background="{DynamicResource MmTaskSectionLineBrush}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Entries}" Margin="28,1,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskEntry">
                  <Button Classes="mm-link" Content="{Binding Text}" Command="{Binding Command}" Height="19"
                          AutomationProperties.Name="{Binding Automation}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
