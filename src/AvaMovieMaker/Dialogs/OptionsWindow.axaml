<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:str="using:AvaMovieMaker.ViewModels"
             xmlns:aw="https://github.com/avawpf"
             xmlns:vm="using:AvaMovieMaker.ViewModels.Dialogs"
             x:Class="AvaMovieMaker.Dialogs.OptionsWindow"
             x:DataType="vm:OptionsViewModel"
             aw:WindowSettings.Title="{x:Static str:Strings.OptionsWindowTitle}" aw:WindowSettings.FrameKind="Dialog" aw:WindowSettings.CanResize="False" aw:WindowSettings.Width="528" aw:WindowSettings.Height="690"
             aw:WindowSettings.WindowStartupLocation="CenterOwner" aw:WindowSettings.ShowInTaskbar="False">
  <DockPanel Margin="12,10,12,12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="{x:Static str:Strings.ButtonOk}" MinWidth="73" IsDefault="True" Click="OnOk" />
      <Button Content="{x:Static str:Strings.ButtonCancel}" MinWidth="73" IsCancel="True" Click="OnCancel" />
    </StackPanel>
    <TabControl Padding="10">
      <TabItem Header="{x:Static str:Strings.OptionsGeneral}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="{x:Static str:Strings.ButtonRestoreAllDefaults}" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <GroupBox Header="{x:Static str:Strings.OptionsGeneralOptions}" Margin="0,28,0,0">
            <StackPanel Spacing="10" Margin="10">
              <TextBlock Text="{x:Static str:Strings.OptionsTemporaryStorage}" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox Text="{Binding TemporaryFolder}" Width="292" PlaceholderText="{x:Static str:Strings.OptionsSystemTemporaryFolder}" AutomationProperties.Name="{x:Static str:Strings.OptionsTemporaryStorageName}" />
                <Button Content="{x:Static str:Strings.ButtonBrowse}" MinWidth="65" Click="OnBrowseTemp" />
              </StackPanel>
              <CheckBox Content="{x:Static str:Strings.OptionsOpenLastProjectOnStartup}" IsChecked="{Binding OpenLastProject}" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox Content="{x:Static str:Strings.OptionsSaveAutoRecoverInfoEvery}" IsChecked="{Binding AutoRecovery}" />
                <NumericUpDown Value="{Binding AutoRecoveryMinutes}" Minimum="1" Maximum="60" Increment="1" FormatString="0" Width="70"
                               IsEnabled="{Binding AutoRecovery}" AutomationProperties.Name="{x:Static str:Strings.OptionsAutoRecoverMinutesName}" />
                <TextBlock Text="{x:Static str:Strings.UnitMinutes}" VerticalAlignment="Center" />
              </StackPanel>
              <CheckBox IsChecked="{Binding OmitMetadata}">
                <TextBlock TextWrapping="Wrap" MaxWidth="350"
                           Text="{x:Static str:Strings.OptionsDoNotIncludeTheTitleAuthor}" />
              </CheckBox>
              <Button Content="{x:Static str:Strings.OptionsResetWarningDialogs}" Command="{Binding ResetWarningsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
              <TextBlock TextWrapping="Wrap"
                         Text="{x:Static str:Strings.OptionsClickThisButtonToSeeAny}" />
            </StackPanel>
          </GroupBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="{x:Static str:Strings.OptionsAdvanced}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="{x:Static str:Strings.ButtonRestoreAllDefaults}" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <StackPanel Spacing="14" Margin="0,28,0,0">
            <GroupBox Header="{x:Static str:Strings.OptionsDefaultDurations}">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock TextWrapping="Wrap" Text="{x:Static str:Strings.OptionsADefaultDurationWillBeAssigned}" Margin="0,0,0,12" />
                <Grid ColumnDefinitions="114,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="{x:Static str:Strings.OptionsPictureDuration}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding PictureSeconds}" Minimum="0.125" Maximum="30" Increment="0.25" Width="70"
                                 AutomationProperties.Name="{x:Static str:Strings.OptionsPictureDurationName}" />
                  <TextBlock Grid.Column="2" Text="{x:Static str:Strings.UnitSeconds}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <TextBlock Grid.Row="1" Text="{x:Static str:Strings.OptionsTransitionDuration}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TransitionSeconds}" Minimum="0.25" Maximum="30" Increment="0.25" Width="70"
                                 AutomationProperties.Name="{x:Static str:Strings.OptionsTransitionDurationName}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static str:Strings.UnitSeconds}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="{x:Static str:Strings.OptionsVideoProperties}">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock TextWrapping="Wrap" Text="{x:Static str:Strings.OptionsTheVideoPropertiesDetermineHowVideo}" Margin="0,0,0,6" />
                <Grid ColumnDefinitions="100,62,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{x:Static str:Strings.OptionsVideoFormat}" VerticalAlignment="Center" />
                  <RadioButton Grid.Column="1" GroupName="format" Content="{x:Static str:Strings.OptionsNTSC}" IsChecked="{Binding !IsPal}" />
                  <RadioButton Grid.Column="2" GroupName="format" Content="{x:Static str:Strings.OptionsPAL}" IsChecked="{Binding IsPal}" />
                  <TextBlock Grid.Row="1" Text="{x:Static str:Strings.OptionsAspectRatio}" VerticalAlignment="Center" />
                  <RadioButton Grid.Row="1" Grid.Column="1" GroupName="aspect" Content="_4:3" IsChecked="{Binding !IsWidescreen}" />
                  <RadioButton Grid.Row="1" Grid.Column="2" GroupName="aspect" Content="16:_9" IsChecked="{Binding IsWidescreen}" />
                </Grid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </DockPanel>
      </TabItem>
      <TabItem Header="{x:Static str:Strings.OptionsCompatibility}">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="{x:Static str:Strings.ButtonRestoreAllDefaults}" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <StackPanel Spacing="14" Margin="0,28,0,0">
            <GroupBox Header="{x:Static str:Strings.OptionsHardwareAcceleration}">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock TextWrapping="Wrap"
                           Text="{x:Static str:Strings.OptionsVideoDriversCanOccasionallyCauseCompatibility}" />
                <CheckBox Content="{x:Static str:Strings.OptionsUseTheGraphicsCardToDecode}" IsChecked="{Binding HardwareDecode}" />
                <CheckBox Content="{x:Static str:Strings.OptionsUseTheGraphicsCardToEncode}" IsChecked="{Binding HardwareEncode}" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="{x:Static str:Strings.OptionsAudioPlayback}">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock Text="{x:Static str:Strings.OptionsPlayAudioThrough}" />
                <ComboBox ItemsSource="{Binding PlaybackDevices}" SelectedItem="{Binding PlaybackDevice}" Width="360" AutomationProperties.Name="{x:Static str:Strings.OptionsPlaybackDeviceName}" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
