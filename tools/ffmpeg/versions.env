# Pinned sources for the FFmpeg builds: build-desktop.sh (linux-x64, osx-arm64, win-x64) sources this file; the GPL
# source offer (each package's SOURCE.txt and BUILDINFO.txt) quotes these revisions.

# FFmpeg's major versions must match FFmpeg.AutoGen 9.0.x (libavcodec 63, libavformat 63, libavutil 61).
FFMPEG_VERSION=n9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz

# x264 has no release tags; this is the head of its stable branch (0.165.r3222).
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_URL=https://code.videolan.org/videolan/x264.git

LIBVPX_VERSION=1.17.0
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz

OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz

DAV1D_VERSION=1.5.4
DAV1D_URL=https://code.videolan.org/videolan/dav1d/-/archive/1.5.4/dav1d-1.5.4.tar.gz

# Built from source and linked statically into the FFmpeg libraries.
ZLIB_VERSION=1.3.1
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz

# linux-x64: libdrm, linked statically into libavutil for the VA-API to DRM PRIME mapping (zero-copy preview).
LIBDRM_VERSION=2.4.134
LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-2.4.134.tar.xz
